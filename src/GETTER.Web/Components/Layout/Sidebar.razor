@* Gradient z logo dla aktywnej ikony menu (używany w CSS: stroke: url(#nav-gradient)) *@
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="nav-gradient" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#FFA45C"/><stop offset=".5" stop-color="#FF4D8D"/><stop offset="1" stop-color="#8B5CF6"/></linearGradient></defs></svg>

<div class="sidebar @(_collapsed ? "collapsed" : "")">
    <div class="logo-container">
        <a href="/" class="brand">
            <img src="@(_collapsed ? "getter-znak.svg" : "getter-logo.svg")" alt="Getter" class="brand-logo" />
        </a>
        <button type="button" class="sidenav-toggle" @onclick="ToggleSidebar" aria-expanded="@(_collapsed ? "false" : "true")" title="@(_collapsed ? "Rozwiń menu" : "Zwiń menu")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 17l-5-5 5-5M18 17l-5-5 5-5" /></svg>
            <span>@(_collapsed ? "Rozwiń menu" : "Zwiń menu")</span>
        </button>
    </div>
    <div class="sidenav-container">
        <nav class="sidenav" aria-label="Menu główne">
            <NavLink class="sidenav-link" title="@(_collapsed ? "Produkty" : null)" href="produkty">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.2v9.6L12 21l-8-4.2V7.2z" /><path d="M4 7.2l8 4.3 8-4.3M12 11.5V21" /></svg>
                <span>Produkty</span>
            </NavLink>
            <NavLink class="sidenav-link" title="@(_collapsed ? "Zamówienia" : null)" href="zamowienia">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 12.2a1.5 1.5 0 0 1-1.5 1.6h-13A1.5 1.5 0 0 1 4 20.2z" /><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3M9 15l2.2 2.2 4-4.4" /></svg>
                <span>Zamówienia</span>
            </NavLink>
            <NavLink class="sidenav-link" title="@(_collapsed ? "Dokumenty" : null)" href="dokumenty">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 2.8h8.5l5 5v12.2a1.5 1.5 0 0 1-1.5 1.5H5.5A1.5 1.5 0 0 1 4 20V4.3a1.5 1.5 0 0 1 1.5-1.5z" /><path d="M14 2.8v4a1.5 1.5 0 0 0 1.5 1.5H19M8 12.5h8M8 15.5h8M8 18.5h5" /></svg>
                <span>Dokumenty</span>
            </NavLink>
            <NavLink class="sidenav-link" title="@(_collapsed ? "Sprzedaż" : null)" href="sprzedaz">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="13.5" width="4" height="7.5" rx="1" /><rect x="10" y="10" width="4" height="11" rx="1" /><rect x="16.5" y="6.5" width="4" height="14.5" rx="1" /><path d="M3.5 8.5l5-3.3 3.6 2L18.5 3M15.2 3h3.5v3.5" /></svg>
                <span>Sprzedaż</span>
            </NavLink>
            <NavLink class="sidenav-link" title="@(_collapsed ? "Obsługa Klienta" : null)" href="obsluga-klienta">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-6.5L7 20.5V16H6a2 2 0 0 1-2-2z" /><path d="M9 9.5h.01M12 9.5h.01M15 9.5h.01" stroke-width="2.6" /></svg>
                <span>Obsługa Klienta</span>
            </NavLink>
            <NavLink class="sidenav-link" title="@(_collapsed ? "Magazyny" : null)" href="" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 9.5L12 4l9.5 5.5v11a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1z" /><path d="M7 21.5v-9h10v9M7 15.5h10M7 18.5h10" /></svg>
                <span>Magazyny</span>
            </NavLink>
            <NavLink class="sidenav-link" title="@(_collapsed ? "Integracje" : null)" href="integracje">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 7.5h13v3.5a6.5 6.5 0 0 1-13 0z" /><path d="M9.2 2.5v5M14.8 2.5v5M12 17.5v4" /></svg>
                <span>Integracje</span>
            </NavLink>
        </nav>
    </div>
    <div class="logout-container">
        <nav class="sidenav" aria-label="Menu główne">
        <NavLink class="sidenav-link" title="@(_collapsed ? "Ustawienia" : null)" href="ustawienia">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.26 5.01 L10.50 2.52 L13.50 2.52 L13.74 5.01 L15.71 5.83 L17.64 4.23 L19.77 6.36 L18.17 8.29 L18.99 10.26 L21.48 10.50 L21.48 13.50 L18.99 13.74 L18.17 15.71 L19.77 17.64 L17.64 19.77 L15.71 18.17 L13.74 18.99 L13.50 21.48 L10.50 21.48 L10.26 18.99 L8.29 18.17 L6.36 19.77 L4.23 17.64 L5.83 15.71 L5.01 13.74 L2.52 13.50 L2.52 10.50 L5.01 10.26 L5.83 8.29 L4.23 6.36 L6.36 4.23 L8.29 5.83Z" /><circle cx="12" cy="12" r="2.8" /></svg>
            <span>Ustawienia</span>
        </NavLink>
        <NavLink class="sidenav-link" title="@(_collapsed ? "Wyloguj" : null)" href="logout">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="M16 17l5-5-5-5M21 12H9" /></svg>
            <span>Wyloguj</span>
        </NavLink>
        </nav>
    </div>
    <div class="sidebar-footer">
        <button type="button" class="sideuser" aria-label="Konto: Marcin Andrzejewski, jelonek@gmail.com" title="Marcin Andrzejewski (jelonek@gmail.com)">
            <span class="useravatar"><svg viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="avbg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8B5CF6" /><stop offset="1" stop-color="#FF4D8D" /></linearGradient></defs><rect width="64" height="64" fill="url(#avbg)" /><path d="M5 64c1-12 11-18 27-18s26 6 27 18z" fill="#23232A" /><rect x="27" y="39" width="10" height="10" rx="3" fill="#E5AB82" /><path d="M25.5 46.5L32 56l6.5-9.5z" fill="#F2F2F5" /><ellipse cx="20.6" cy="30" rx="2.2" ry="3.4" fill="#EBB48B" /><ellipse cx="43.4" cy="30" rx="2.2" ry="3.4" fill="#EBB48B" /><ellipse cx="32" cy="29" rx="11.2" ry="13.2" fill="#F2C29B" /><path d="M20.4 28c-1.6-11.5 4.6-18 11.6-18s13.2 6.5 11.6 18c-1.4-5.6-5-8.4-11.6-8.4S21.8 22.4 20.4 28z" fill="#2B1D16" /><circle cx="27.4" cy="30.4" r="1.5" fill="#2B1D16" /><circle cx="36.6" cy="30.4" r="1.5" fill="#2B1D16" /><path d="M24.8 26.6c1.8-1.2 4-1.3 5.8-.5M33.4 26.1c1.8-.8 4-.7 5.8.5" stroke="#2B1D16" stroke-width="1.3" fill="none" stroke-linecap="round" /><path d="M28.2 36c2.4 2.3 5.2 2.3 7.6 0" stroke="#B5694A" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg></span>
            <span class="dot ok" aria-hidden="true"></span>
            <span class="usertext">
                <span class="username">Marcin Andrzejewski</span>
                <span class="useremail">jelonek@gmail.com</span>
            </span>
        </button>
    </div>
</div>

@code {
    private bool _collapsed;

    private void ToggleSidebar() => _collapsed = !_collapsed;
}
